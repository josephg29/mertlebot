# Copy this file to .env and fill in your real key.
# Never commit .env to version control.

# Anthropic API key — required. The whole generation pipeline runs on it.
ANTHROPIC_API_KEY=sk-ant-...

# Server port (default: 3000)
# PORT=3000

# Global per-day cap on Anthropic-billed requests, to bound spend on a public
# demo. Default 300. Set to 0 to disable (e.g. a private self-hosted instance).
# DEMO_DAILY_LIMIT=300
